  "formulas": {
    "panel_final_value": {
      "evidence": "formula",
      "sourcePage": 4,
      "expression": "baseValue * (1 + percentBonus) + fixedAddition",
      "scope": "panel_composition_only",
      "warning": "已有面板最终值时不可再次叠加其来源。"
    },
    "attack_roll": {
      "evidence": "formula",
      "sourcePage": 6,
      "expression": "randomIntegerInDocumentedAttackRange(physicalAttackMin, physicalAttackMax)",
      "inputDomain": "physicalAttackMin and physicalAttackMax are finite integers and physicalAttackMin <= physicalAttackMax",
      "workingAssumptions": {
        "endpointsIncluded": {"value": true, "status": "pending_server_validation"},
        "distribution": {"value": "uniform", "status": "pending_server_validation"}
      },
      "notes": [
        "面板攻击是区间中点，不是单次命中值。",
        "资料声称多段技能各段独立随机；服务器是否严格均匀、端点是否包含仍待验证。当前整数枚举把两端包含作为工作假设，不能称为服务器已证实行为。",
        "攻击中点只能用于推荐期望或中点分支估算；校准一条实测跳字时必须枚举区间内的整数攻击值，不能把连续端点当作服务器跳字。"
      ]
    },
    "armor_delta": {
      "evidence": "formula",
      "sourcePage": 7,
      "variables": {"P": "sourceArmorBreak", "H": "targetArmor"},
      "piecewise": [
        {"when": "H <= P", "expression": "(P - H) / 3"},
        {"when": "P <= H / 4", "expression": "2 * P - H"},
        {"when": "otherwise", "expression": "(P - H) * 2 / 3"}
      ],
      "notes": [
        "结果直接加到攻击随机值，可为小数和负数。",
        "示例 P=108,H=146 得 -25.3。服务器中间取整位置仍待验证。"
      ]
    },
    "specialization_delta": {
      "evidence": "formula",
      "sourcePage": 7,
      "expression": "max(sourceSpecialization[targetType] - targetSpecializationDefense[sourceType], 0)",
      "notes": [
        "玩家打怪取怪物专攻子项，玩家打玩家取途径专攻子项；两者不可相加。",
        "训练木桩在资料中按精英怪物处理。"
      ]
    },
    "effective_defense": {
      "evidence": "formula",
      "sourcePage": 7,
      "expression": "max(targetDefense - sourceBreakFlat, 0) * (1 - sourceBreakPercent)",
      "inputDomain": "0 <= sourceBreakPercent <= 1",
      "notes": ["固定破防先扣，百分比破防后乘。百分比忽防超出 0%–100% 时不属于本模型已验证定义域。"]
    },
    "defense_reduction": {
      "evidence": "formula",
      "sourcePage": 7,
      "expression": "clamp(effectiveDefense * 0.85 / (effectiveDefense + combatLevel * 31.68), 0.25, 0.80)"
    },
    "defense_multiplier": {
      "evidence": "formula",
      "sourcePage": 7,
      "expression": "1 - defenseReduction",
      "range": [0.20, 0.75]
    },
    "level_coefficient": {
      "evidence": "formula",
      "sourcePage": 9,
      "expression": "1.12 * combatLevel when combatLevel <= 45; 0.48 * (combatLevel - 45) + 50.4 when combatLevel > 45"
    },
    "crit_rate": {
      "evidence": "formula",
      "sourcePage": 9,
      "variables": {"c": "sourceCrit - targetAntiCrit", "k": "levelCoefficient"},
      "expression": "clamp((2 * c + 45 * k) / (c + 180 * k), 0.05, 0.75)",
      "inputDomain": "combatLevel > 0 and c + 180 * k > 0",
      "notes": ["c=0时为25%；不可用角色面板的对空气暴击百分比替代实战概率。分母非正时，资料未定义该函数；不得在 clamp 后伪装成有效概率。"]
    },
    "pierce_rate": {
      "evidence": "formula",
      "sourcePage": 10,
      "variables": {"r": "sourcePierce - targetBlock", "k": "levelCoefficient"},
      "expression": "clamp((1.5 * r + 135 * k) / (r + 180 * k), 0.25, 1.0)",
      "inputDomain": "combatLevel > 0 and r + 180 * k > 0",
      "notes": ["分母非正时，资料未定义该函数；不得在 clamp 后伪装成有效概率。"]
    },
    "block_rate": {
      "evidence": "formula",
      "sourcePage": 10,
      "expression": "1 - pierceRate",
      "range": [0.0, 0.75]
    },
    "event_multiplier": {
      "evidence": "inference",
      "sourcePage": 10,
      "assumption": "block_then_crit",
      "expression": "blockRate * 0.3 + (1 - blockRate) * critRate * critMultiplier + (1 - blockRate) * (1 - critRate)",
      "requiresExplicitStrategy": true,
      "allowedUses": ["probability_weighted_estimate"],
      "disallowedUses": ["claiming_confirmed_server_event_order", "inferring_an_unlabelled_observed_event"],
      "notes": [
        "资料明确标为推断，只与720次木桩统计相容。",
        "格挡命中不暴击；最终伤害增强不受格挡影响。",
        "必须让用户看见并选择该推断策略；策略未选择时，概率加权输出不可用。普通/暴击/格挡已有明确实测标签时，可分别校准分支，但不因此证实事件顺序。"
      ]
    },
    "crit_multiplier": {
      "evidence": "formula",
      "sourcePage": 8,
      "expression": "clamp(sourceCritDamage - targetCritDamageReduction, 1.25, 2.5)",
      "notes": ["百分比输入应转为小数，例如154%=1.54。"]
    },
    "suppression_multiplier": {
      "evidence": "formula",
      "sourcePage": 8,
      "expression": "campBaseMultiplier * max(0, 1 + sourceSuppression - targetResistance)",
      "pendingInput": "campBaseMultiplier",
      "notes": ["阵营基础倍率未恢复时，1x 只能作为显式实验假设，不能作为未知事实的默认值。"]
    },
    "increase_multiplier": {
      "evidence": "formula",
      "sourcePage": 8,
      "expression": "max(0, 1 + comboBonus + sourceDamageIncrease - targetDamageReduction)"
    },
    "deepening_multiplier": {
      "evidence": "formula",
      "sourcePage": 8,
      "expression": "max(0, 1 + sourceDamageDeepening - targetDamageMitigation)",
      "notes": ["与增伤/减伤是不同的独立乘区。"]
    },
    "cross_type_multiplier": {
      "evidence": "formula",
      "sourcePage": 8,
      "expression": "max(0, 1 + sourceCrossTypeIncrease - targetCrossTypeImmunity)",
      "inputRequirements": ["sourceCrossTypeIncrease", "targetCrossTypeImmunity", "damageTypeAndTargetClass"],
      "notes": ["没有跨类关系和双方对应输入时，该乘区是未建模，不得静默当作已知 1x。"]
    },
    "weakness_multiplier": {
      "evidence": "formula",
      "sourcePage": 8,
      "expression": "1 + targetWeakness",
      "inputDomain": "targetWeakness >= -1",
      "notes": ["目标弱点低于 -100% 不属于已验证定义域。"]
    },
    "monster_correction": {
      "evidence": "formula",
      "sourcePage": 8,
      "expression": "(1 + targetBossWeakness) * sourceAttackCorrection * targetDefenseCorrection",
      "inputRequirements": ["targetBossWeakness", "sourceAttackCorrection", "targetDefenseCorrection", "targetScenario"],
      "notes": ["没有目标情境数据时应禁用，不得默认为未知修正；玩家与建筑不应套用怪物修正。"]
    },
    "final_fixed_delta": {
      "evidence": "formula",
      "sourcePage": 9,
      "expression": "sourceFinalDamageBonus - targetFinalDamageResistance",
      "position": "after_all_multiplications"
    },
    "damage_floor": {
      "evidence": "formula",
      "sourcePage": 9,
      "expression": "max(coreResolvedDamage + finalFixedDelta, baseDamage * 0.005, 1)",
      "display": "round(finalDamage)",
      "notes": [
        "资料称先扣护盾，再扣生命；特殊固定/比例扣血可能绕过护盾。",
        "单个事件分支必须先完成该分支的最终保底，再四舍五入显示。不能先对未保底分支概率加权、再统一做一次保底。"
      ]
    },
    "recommended_expected_damage": {
      "evidence": "derived",
      "sourcePage": 11,
      "expression": "baseDamageAtAttackMidpoint * increaseMultiplier * deepeningMultiplier * suppressionMultiplier * eventMultiplier + finalFixedDelta",
      "scope": "recommendation_and_relative_comparison",
      "omits": ["crossTypeMultiplier", "weaknessMultiplier", "targetCountCoefficient", "monsterCorrection"],
      "includes": ["attackMidpoint", "suppressionMultiplier", "increaseMultiplier", "deepeningMultiplier", "selectedEventStrategy"],
      "excludes": ["perEventDamageFloor", "displayRounding", "shieldLoss", "healthLoss"],
      "warning": "适合词条排序，不适合预测某一击数字，也不等于所有单次最终分支的数学期望。"
    },
    "single_hit_expectation": {
      "evidence": "derived",
      "expression": "P(block) * finalBlockedDamage + P(crit) * finalCriticalDamage + P(normal) * finalNormalDamage",
      "scope": "probability_weighted_final_single_hit_under_selected_event_strategy",
      "requires": ["eventOrderStrategy", "perEventDamageFloor", "perEventRoundingSemantics"],
      "warning": "这是每个事件分支各自保底后的概率加权；仅当事件策略已明确选择时才可输出。它与 recommended_expected_damage 是不同的结果口径。"
    },
    "target_count_coefficient": {
      "evidence": "formula",
      "sourcePage": 8,
      "expression": "affectedTargetCount <= fullDamageTargetCount ? 1 : max(fullDamageTargetCount / affectedTargetCount, 0.08)",
      "scope": "actions_with_a_recorded_fullDamageTargetCount",
      "inputRequirements": ["affectedTargetCount", "fullDamageTargetCount"],
      "notes": [
        "资料原文：命中目标数≤技能满伤目标数时为1；超过时为技能满伤目标数÷实际命中数，最低0.08。",
        "单体动作记录 affectedTargetCount=1、fullDamageTargetCount=1 时系数为1；这只说明该次动作条件，不代表其它动作的满伤目标数也是1。",
        "范围、多目标、弹射、分摊或额外命中动作必须记录实际命中目标数与该技能的满伤目标数；缺任一输入时绝对预测/校准不可用。"
      ]
    },
    "snapshot_action_empirical_calibration": {
      "evidence": "empirical",
      "expression": "feasibleCoefficientSet = intersection_over_samples(searchCoefficient(fullFinalDamage(actionSnapshot, integerAttackRoll, labelledEvent) roundsTo observedJump))",
      "scope": "named_action_and_named_hit_segment_with_identical_snapshot",
      "requiresSnapshot": [
        "actionName",
        "hitSegment",
        "damageType",
        "sourceSnapshot",
        "targetSnapshot",
        "targetType",
        "targetScenario",
        "affectedTargetCount",
        "fullDamageTargetCount",
        "allBuffsAndStates",
        "eventLabel",
        "eventOrderStrategyIfProbabilityUsed",
        "conditionalMultiplierEvidence"
      ],
      "invalidatesWhenChanged": [
        "actionName",
        "hitSegment",
        "damageType",
        "anySourceOrTargetInput",
        "targetType",
        "targetScenario",
        "affectedTargetCount",
        "fullDamageTargetCount",
        "buffOrState",
        "eventStrategy",
        "roundingAssumption",
        "conditionalMultiplierState"
      ],
      "notes": [
        "经验有效系数可以吸收同一快照下尚未拆开的动作内部项，但不能证明技能内部裸系数，也不能迁移到其它动作、命中段、攻防快照、目标数或状态。",
        "反解必须运行含最终固定项、保底和显示取整的完整事件函数；保底/负固定项附近不得使用线性相除。",
        "未识别的实测事件不得自动归为普通；必须要求明确标签或拒绝该样本。"
      ]
    },
    "result_semantics": {
      "evidence": "formula",
      "sourcePages": [6, 11, 12, 15],
      "definitions": {
        "base_damage": "攻击随机值、破甲差、专攻差与防御倍率等完成后的基础层。",
        "core_resolved_damage": "基础伤害经过适用乘区与事件倍率后的乘法结算层，尚未加入最终固定项。",
        "resolved_damage": "core_resolved_damage 加上最终固定项后的结算层。",
        "single_final_damage": "max(resolved_damage, 基础伤害 * 0.5%, 1)，可保留小数。",
        "display_jump": "round(单次最终伤害)。",
        "recommended_expected_damage": "用攻击区间中点与选定事件策略计算的推荐/词条比较模型；省略跨类、弱点、目标数和怪物修正，不代表单次跳字或实际生命扣除。",
        "single_hit_expectation": "各事件分支完成最终保底后，按已选事件策略概率加权的可选模型；不同于推荐期望，也不代表实际生命扣除。",
        "shield_and_health": "资料确认最终伤害先扣护盾、再扣生命，但未给出护盾吸收、溢出与取整的完整公式。"
      },
      "implementationRule": "界面必须把期望伤害、条件分支最终伤害、显示跳字、实测护盾损失与实测生命损失分开显示和记录。"
    },
    "skill_enhancement_multiplier": {
      "evidence": "formula",
      "sourcePage": 7,
      "expression": "clamp(1 + 0.025 * (sourceSkillEnhancement - targetSkillResistance) / combatLevel, 0.05, 2.5)",
      "scope": "verified_or_empirically_calibrated_named_action_only; normal_attack_pending",
      "notes": ["第16页另有录屏支持条目称平A也吃技能增强，存在证据冲突。对任意具名技能可作为候选公式项，但必须由该动作证据或同快照校准支持。"]
    },
    "skill_level_part": {
      "evidence": "formula",
      "sourcePage": 7,
      "expression": "skillCoefficient * skillLevel * 120 * skillEnhancementMultiplier",
      "scope": "named_active_skill_only_when_the_action_formula_or_same-snapshot empirical calibration establishes_it",
      "notes": ["不能因为页面存在技能等级、技能增强或说明数字，就为任意技能自动加入该项。"]
    },
    "skill_description_value": {
      "evidence": "verified",
      "sourcePage": 14,
      "expression": "floor(skillCoefficient * (attackMidpoint + 120 * skillLevel))",
      "scope": "skill_tooltip_display_only",
      "notes": ["不含随机、破甲、专攻、防御、技能增强和其他乘区。该关系仅限资料明确覆盖的具名技能/命中段，未知技能说明值只能保存为证据，不得自动反推系数。"]
    },
    "control_multiplier": {
      "evidence": "formula",
      "sourcePage": 16,
      "expression": "clamp(1 + 2.5 * difference / (difference + 20 * levelCoefficient), 0.5, 2.0)",
      "scope": "control_only"
    }
  },
