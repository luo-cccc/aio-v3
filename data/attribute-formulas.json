  "formulas": {
    "panel_final_value": {
      "evidence": "formula",
      "sourcePage": 4,
      "expression": "baseValue * (1 + percentBonus) + fixedAddition",
      "scope": "panel_composition_only",
      "warning": "已有面板最终值时不可再次叠加其来源。"
    },
    "attack_roll": {
      "evidence": "formula",
      "sourcePage": 6,
      "expression": "randomIntegerBetween(physicalAttackMin, physicalAttackMax)",
      "notes": [
        "面板攻击是区间中点，不是单次命中值。",
        "资料声称多段技能各段独立随机；服务器是否严格均匀、端点是否包含仍待验证。"
      ]
    },
    "armor_delta": {
      "evidence": "formula",
      "sourcePage": 7,
      "variables": {
        "P": "sourceArmorBreak",
        "H": "targetArmor"
      },
      "piecewise": [
        {
          "when": "H <= P",
          "expression": "(P - H) / 3"
        },
        {
          "when": "P <= H / 4",
          "expression": "2 * P - H"
        },
        {
          "when": "otherwise",
          "expression": "(P - H) * 2 / 3"
        }
      ],
      "notes": [
        "结果直接加到攻击随机值，可为小数和负数。",
        "示例 P=108,H=146 得 -25.3。服务器中间取整位置仍待验证。"
      ]
    },
    "specialization_delta": {
      "evidence": "formula",
      "sourcePage": 7,
      "expression": "max(sourceSpecialization[targetType] - targetSpecializationDefense[sourceType], 0)",
      "notes": [
        "玩家打怪取怪物专攻子项，玩家打玩家取途径专攻子项；两者不可相加。",
        "训练木桩在资料中按精英怪物处理。"
      ]
    },
    "effective_defense": {
      "evidence": "formula",
      "sourcePage": 7,
      "expression": "max(targetDefense - sourceBreakFlat, 0) * (1 - sourceBreakPercent)",
      "notes": [
        "固定破防先扣，百分比破防后乘。"
      ]
    },
    "defense_reduction": {
      "evidence": "formula",
      "sourcePage": 7,
      "expression": "clamp(effectiveDefense * 0.85 / (effectiveDefense + combatLevel * 31.68), 0.25, 0.80)"
    },
    "defense_multiplier": {
      "evidence": "formula",
      "sourcePage": 7,
      "expression": "1 - defenseReduction",
      "range": [
        0.2,
        0.75
      ]
    },
    "level_coefficient": {
      "evidence": "formula",
      "sourcePage": 9,
      "expression": "1.12 * combatLevel when combatLevel <= 45; 0.48 * (combatLevel - 45) + 50.4 when combatLevel > 45"
    },
    "crit_rate": {
      "evidence": "formula",
      "sourcePage": 9,
      "variables": {
        "c": "sourceCrit - targetAntiCrit",
        "k": "levelCoefficient"
      },
      "expression": "clamp((2 * c + 45 * k) / (c + 180 * k), 0.05, 0.75)",
      "notes": [
        "c=0时为25%；不可用角色面板的对空气暴击百分比替代实战概率。"
      ]
    },
    "pierce_rate": {
      "evidence": "formula",
      "sourcePage": 10,
      "variables": {
        "r": "sourcePierce - targetBlock",
        "k": "levelCoefficient"
      },
      "expression": "clamp((1.5 * r + 135 * k) / (r + 180 * k), 0.25, 1.0)"
    },
    "block_rate": {
      "evidence": "formula",
      "sourcePage": 10,
      "expression": "1 - pierceRate",
      "range": [
        0,
        0.75
      ]
    },
    "event_multiplier": {
      "evidence": "inference",
      "sourcePage": 10,
      "assumption": "block_then_crit",
      "expression": "blockRate * 0.3 + (1 - blockRate) * critRate * critMultiplier + (1 - blockRate) * (1 - critRate)",
      "notes": [
        "资料明确标为推断，只与720次木桩统计相容。",
        "格挡命中不暴击；最终伤害增强不受格挡影响。"
      ]
    },
    "crit_multiplier": {
      "evidence": "formula",
      "sourcePage": 8,
      "expression": "clamp(sourceCritDamage - targetCritDamageReduction, 1.25, 2.5)",
      "notes": [
        "百分比输入应转为小数，例如154%=1.54。"
      ]
    },
    "suppression_multiplier": {
      "evidence": "formula",
      "sourcePage": 8,
      "expression": "campBaseMultiplier * max(0, 1 + sourceSuppression - targetResistance)",
      "pendingInput": "campBaseMultiplier"
    },
    "increase_multiplier": {
      "evidence": "formula",
      "sourcePage": 8,
      "expression": "max(0, 1 + comboBonus + sourceDamageIncrease - targetDamageReduction)"
    },
    "deepening_multiplier": {
      "evidence": "formula",
      "sourcePage": 8,
      "expression": "max(0, 1 + sourceDamageDeepening - targetDamageMitigation)",
      "notes": [
        "与增伤/减伤是不同的独立乘区。"
      ]
    },
    "cross_type_multiplier": {
      "evidence": "formula",
      "sourcePage": 8,
      "expression": "max(0, 1 + sourceCrossTypeIncrease - targetCrossTypeImmunity)"
    },
    "weakness_multiplier": {
      "evidence": "formula",
      "sourcePage": 8,
      "expression": "1 + targetWeakness"
    },
    "monster_correction": {
      "evidence": "formula",
      "sourcePage": 8,
      "expression": "(1 + targetBossWeakness) * sourceAttackCorrection * targetDefenseCorrection",
      "notes": [
        "没有目标情境数据时应禁用，不得默认为未知修正。"
      ]
    },
    "final_fixed_delta": {
      "evidence": "formula",
      "sourcePage": 9,
      "expression": "sourceFinalDamageBonus - targetFinalDamageResistance",
      "position": "after_all_multiplications"
    },
    "damage_floor": {
      "evidence": "formula",
      "sourcePage": 9,
      "expression": "max(resolvedDamage, baseDamage * 0.005, 1)",
      "display": "round(finalDamage)",
      "notes": [
        "资料称先扣护盾，再扣生命；特殊固定/比例扣血可能绕过护盾。"
      ]
    },
    "expected_damage": {
      "evidence": "formula",
      "sourcePage": 11,
      "expression": "baseDamageAtAttackMidpoint * increaseMultiplier * deepeningMultiplier * suppressionMultiplier * eventMultiplier + finalFixedDelta",
      "scope": "recommendation_and_relative_comparison",
      "omits": [
        "crossTypeMultiplier",
        "weaknessMultiplier",
        "targetCountCoefficient",
        "monsterCorrection"
      ],
      "warning": "适合词条排序，不适合预测某一击数字。"
    },
    "result_semantics": {
      "evidence": "formula",
      "sourcePages": [
        6,
        11,
        12,
        15
      ],
      "definitions": {
        "base_damage": "攻击随机值、破甲差、专攻差与防御倍率等完成后的基础层。",
        "resolved_damage": "基础伤害经过适用乘区、事件倍率与最终固定项后的结算层。",
        "single_final_damage": "max(结算伤害, 基础伤害 * 0.5%, 1)，可保留小数。",
        "display_jump": "round(单次最终伤害)。",
        "expected_damage": "用攻击区间中点与事件概率算出的长期比较模型；不代表单次跳字或实际生命扣除。",
        "shield_and_health": "资料确认最终伤害先扣护盾、再扣生命，但未给出护盾吸收、溢出与取整的完整公式。"
      },
      "implementationRule": "界面必须把期望伤害、条件分支最终伤害、显示跳字、实测护盾损失与实测生命损失分开显示和记录。"
    },
    "skill_enhancement_multiplier": {
      "evidence": "formula",
      "sourcePage": 7,
      "expression": "clamp(1 + 0.025 * (sourceSkillEnhancement - targetSkillResistance) / combatLevel, 0.05, 2.5)",
      "scope": "active_skill_only_until_normal_attack_test",
      "notes": [
        "第16页另有录屏支持条目称平A也吃技能增强，存在证据冲突。"
      ]
    },
    "skill_level_part": {
      "evidence": "formula",
      "sourcePage": 7,
      "expression": "skillCoefficient * skillLevel * 120 * skillEnhancementMultiplier",
      "scope": "active_skill_only"
    },
    "skill_description_value": {
      "evidence": "verified",
      "sourcePage": 14,
      "expression": "floor(skillCoefficient * (attackMidpoint + 120 * skillLevel))",
      "scope": "skill_tooltip_display_only",
      "notes": [
        "不含随机、破甲、专攻、防御、技能增强和其他乘区。"
      ]
    },
    "control_multiplier": {
      "evidence": "formula",
      "sourcePage": 16,
      "expression": "clamp(1 + 2.5 * difference / (difference + 20 * levelCoefficient), 0.5, 2.0)",
      "scope": "control_only"
    }
  },
